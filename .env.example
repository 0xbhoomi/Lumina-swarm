# ==================== PROJECT CONFIG ====================
PROJECT_NAME=LuminaSwarm
NETWORK=base-sepolia

# ==================== MARKET DATA ====================
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# ==================== WALLET (TESTNET ONLY!) ====================
PRIVATE_KEY=0xYourTestnetPrivateKeyHere   # Get from MetaMask (Base Sepolia)
WALLET_ADDRESS=0xYourTestWalletAddress

# ==================== 0G ====================
OG_RPC_URL=https://rpc.0g.ai
OG_STORAGE_API_KEY=your_0g_storage_key_if_needed
OG_CHAIN_ID=999  # or whatever 0G testnet uses

# ==================== GENSYN AXL ====================
AXL_PORT=9002
AXL_NODE_URL=http://localhost:9002

# ==================== UNISWAP ====================
UNISWAP_API_KEY=  # Optional, leave empty for public use
UNISWAP_V3_ROUTER=0x...   # (usually auto-detected)

# ==================== KEEPERHUB ====================
KEEPERHUB_MCP_URL=http://localhost:3001   # or their MCP endpoint
KEEPERHUB_API_KEY=your_keeperhub_key_if_any

# ==================== OTHER ====================
OPENCLAW_MODEL=qwen3.6-plus   # or GLM-5
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_if_using_telegram
